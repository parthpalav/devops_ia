{
  "name": "opsdesk-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright end-to-end quality gate for OpsDesk",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:all-browsers": "PW_BROWSERS=chromium,firefox,webkit playwright test",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
