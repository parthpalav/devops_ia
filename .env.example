# OpsDesk demo/development configuration.
# Every value below is a NON-SECRET demo default. Never reuse these in production.
# Copying this file to `.env` is optional: compose.yml already contains the same defaults.

POSTGRES_DB=opsdesk
POSTGRES_USER=opsdesk
POSTGRES_PASSWORD=opsdesk_dev_password

# Used by the backend. Inside Docker Compose the host is the `db` service name.
DATABASE_URL=postgresql://opsdesk:opsdesk_dev_password@db:5432/opsdesk

JWT_SECRET=demo-only-change-me
JWT_EXPIRES_IN=1h

# Seeded demo account (see database/init/001_schema.sql). Used by the Playwright suite.
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=Demo123!

# Enables POST /api/test/reset. Test/demo only - never enable in production.
ENABLE_TEST_ENDPOINTS=true

# Demo-only fault injection: none | drop_ticket_write
# Only forwarded to the backend by compose.demo.yml.
FAULT_INJECTION_MODE=none

PLAYWRIGHT_BASE_URL=http://frontend
CI=false

# Host ports (change these if a port is already in use on your machine)
FRONTEND_PORT=8080
BACKEND_PORT=3000
REPORT_PORT=9323
