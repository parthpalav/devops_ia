# Normalise line endings so the project works when cloned on Windows.
* text=auto

# Shell scripts, Dockerfiles, configs and SQL are executed/parsed inside Linux containers: always LF.
*.sh            text eol=lf
Dockerfile      text eol=lf
*.conf          text eol=lf
*.yml           text eol=lf
*.sql           text eol=lf

# PowerShell runs fine with either; CRLF is the Windows convention.
*.ps1           text eol=crlf

*.png           binary
